# Firebase ve Reklam yapılandırmalarını gizle
# UYARI: lib/firebase_options.dart dosyasını gizlemek, başkalarının projeyi kendi Firebase
# projelerine bağlamasını gerektirir (flutterfire configure).
# Genellikle bu dosya gizlenmez, güvenlik Firebase kurallarıyla sağlanır.
lib/firebase_options.dart
# UYARI: lib/ad_helper.dart dosyasını gizlemek, reklamların çalışması için bu dosyanın
# manuel olarak sağlanmasını gerektirir. Reklam ID'leri genellikle gizli değildir.
lib/ad_helper.dart
