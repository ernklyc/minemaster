**/android/gradlew.bat
**/android/local.properties
# GeneratedPluginRegistrant.java # Genellikle bu doğrudan eklenmez

# Android Keystore files - ÇOK ÖNEMLİ - ASLA PAYLAŞMAYIN!
*.jks
*.keystore
**/android/key.properties

# iOS/XCode related
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/*sync/
**/ios/**/.sconsign.dblite
**/ios/**/.tags*
**/ios/**/.vagrant/
**/ios/**/DerivedData/
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/profile # Profiling datası
**/ios/**/xcuserdata
**/ios/.generated/
# Flutter.framework and App.framework are not checked in.
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
# Generated.xcconfig needs to be checked in (see https://github.com/flutter/flutter/issues/10611).
# Snapshots can be large and problematic, so we exclude them unless a subclass project
# explicitly checks them in.
# **/ios/Runner/Assets.xcassets/AppIcon.appiconset/Icon-App-* # Genellikle ikonu hariç tutmazsınız
**/ios/Flutter/flutter_assets/
**/ios/ServiceDefinitions.json

# Firebase
# lib/firebase_options.dart dosyası genellikle GİT'E EKLENİR.
# Eğer projenizi açık kaynak olarak paylaşıyorsanız ve başkalarının kendi Firebase
# projelerini kullanmalarını istiyorsanız, aşağıdaki satırı aktifleştirebilirsiniz.
# Bu durumda, kullanıcıların `flutterfire configure` komutunu çalıştırmaları gerekir.
# lib/firebase_options.dart

# Eğer google-services.json (Android) ve GoogleService-Info.plist (iOS) dosyalarını
# manuel olarak projenize ekliyorsanız ve bunları repoda tutmak istemiyorsanız (ÖNERİLİR):
**/android/app/google-services.json
**/ios/Runner/GoogleService-Info.plist
**/firebase_app_id_file.json

# Web ile ilgili (eğer web için ayrı bir Firebase yapılandırma dosyası kullanıyorsanız)
# web/firebase-config.js

